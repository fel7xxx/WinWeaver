<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinWeaver на Avalonia.
    net48  — основная сборка для Windows (PowerShell 5.1 хостится в процессе, как и раньше).
    net8.0 — кроссплатформенная сборка для разработки/скриншотов (только демо-движок /fake).
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WinWeaver</AssemblyName>
    <RootNamespace>WinWeaver</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>Resources\app.manifest</ApplicationManifest>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <Product>WinWeaver</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0649;CS0414;CS0169;CS0067;CS8981;CA1416;NU1701</NoWarn>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefineConstants>$(DefineConstants);PSENGINE</DefineConstants>
    <!-- Один самостоятельный exe: библиотеки встраиваются в ресурсы (см. App/Embedded.cs) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <DebugType>embedded</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <ShouldIncludeNativeSkiaSharp>False</ShouldIncludeNativeSkiaSharp>
    <ShouldIncludeNativeHarfBuzzSharp>False</ShouldIncludeNativeHarfBuzzSharp>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);HEADLESS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Только для режима скриншотов без дисплея (ключ shots) -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Только для компиляции: настоящая System.Management.Automation берётся из GAC Windows -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Resources\engine.ps1" LogicalName="engine.ps1" />
    <EmbeddedResource Include="Resources\winweaver.ico" LogicalName="winweaver.ico" />
    <EmbeddedResource Include="Resources\hero.jpg" LogicalName="hero.jpg" />
    <EmbeddedResource Include="Resources\wall*.jpg" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Resources\br_*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\lang.en.tsv" LogicalName="lang.en.tsv" WithCulture="false" />
    <EmbeddedResource Include="Assets\Fonts\font.regular.ttf" LogicalName="font.regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\font.semibold.ttf" LogicalName="font.semibold.ttf" />
  </ItemGroup>
  <!--
    net48: один самостоятельный WinWeaver.exe. Все DLL из пакетов (управляемые и нативные win-x64)
    сжимаются и встраиваются в ресурсы, а в папку сборки/публикации не копируются.
  -->
  <UsingTask TaskName="WWGzip" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutDir);
        foreach (var f in Files)
        {
          string target = Path.Combine(OutDir, Path.GetFileName(f.ItemSpec) + ".gz");
          if (File.Exists(target) && File.GetLastWriteTimeUtc(target) >= File.GetLastWriteTimeUtc(f.ItemSpec)) continue;
          using (var input = File.OpenRead(f.ItemSpec))
          using (var output = File.Create(target))
          using (var gz = new GZipStream(output, CompressionLevel.Optimal))
            input.CopyTo(gz);
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="WWEmbedDependencies" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources" Condition="'$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <_WWNative Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp' Or '%(Filename)' == 'av_libglesv2')" />
      <_WWLib Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' And '%(Filename)' != 'libSkiaSharp' And '%(Filename)' != 'libHarfBuzzSharp' And '%(Filename)' != 'av_libglesv2'" />
    </ItemGroup>
    <Error Condition="'@(_WWNative->Count())' != '3'" Text="Ожидались 3 нативные библиотеки win-x64 (libSkiaSharp, libHarfBuzzSharp, av_libglesv2), найдено: @(_WWNative->'%(Filename)')" />
    <WWGzip Files="@(_WWLib);@(_WWNative)" OutDir="$(IntermediateOutputPath)embed" />
    <ItemGroup>
      <EmbeddedResource Include="@(_WWLib->'$(IntermediateOutputPath)embed\%(Filename)%(Extension).gz')" LogicalName="ww.lib.%(Filename)%(Extension).gz" WithCulture="false" Type="Non-Resx" />
      <EmbeddedResource Include="@(_WWNative->'$(IntermediateOutputPath)embed\%(Filename)%(Extension).gz')" LogicalName="ww.native.%(Filename)%(Extension).gz" WithCulture="false" Type="Non-Resx" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
  <Target Name="WWSingleFilePublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' Or '%(Extension)' == '.config' Or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
