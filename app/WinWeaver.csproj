<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WinWeaver</AssemblyName>
    <RootNamespace>WinWeaver</RootNamespace>
    <ApplicationIcon>winweaver.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="engine.ps1" LogicalName="engine.ps1" />
    <EmbeddedResource Include="winweaver.ico" LogicalName="winweaver.ico" />
    <EmbeddedResource Include="hero.jpg" LogicalName="hero.jpg" />
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="logos\br_firefox.png" LogicalName="br_firefox.png" />
    <EmbeddedResource Include="logos\br_chrome.png" LogicalName="br_chrome.png" />
    <EmbeddedResource Include="logos\br_brave.png" LogicalName="br_brave.png" />
    <EmbeddedResource Include="logos\br_yandex.png" LogicalName="br_yandex.png" />
    <EmbeddedResource Include="logos\br_operagx.png" LogicalName="br_operagx.png" />
    <EmbeddedResource Include="logos\br_keep.png" LogicalName="br_keep.png" />
    <EmbeddedResource Include="walls\wall1.jpg" LogicalName="wall1.jpg" />
    <EmbeddedResource Include="walls\wall2.jpg" LogicalName="wall2.jpg" />
    <EmbeddedResource Include="walls\wall3.jpg" LogicalName="wall3.jpg" />
    <EmbeddedResource Include="walls\wall4.jpg" LogicalName="wall4.jpg" />
    <EmbeddedResource Include="walls\wall1_t.jpg" LogicalName="wall1_t.jpg" />
    <EmbeddedResource Include="walls\wall2_t.jpg" LogicalName="wall2_t.jpg" />
    <EmbeddedResource Include="walls\wall3_t.jpg" LogicalName="wall3_t.jpg" />
    <EmbeddedResource Include="walls\wall4_t.jpg" LogicalName="wall4_t.jpg" />
    <EmbeddedResource Include="walls\wall1_h.jpg" LogicalName="wall1_h.jpg" />
    <EmbeddedResource Include="walls\wall2_h.jpg" LogicalName="wall2_h.jpg" />
    <EmbeddedResource Include="walls\wall3_h.jpg" LogicalName="wall3_h.jpg" />
    <EmbeddedResource Include="walls\wall4_h.jpg" LogicalName="wall4_h.jpg" />
    <EmbeddedResource Include="lang\en.tsv" LogicalName="lang.en.tsv" />
  </ItemGroup>
</Project>
